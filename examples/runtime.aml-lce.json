{
  "data_dir": "data",
  "compiler": {
    "type": "openai",
    "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
    "model": "deepseek-v4.1-flash-1017",
    "api_key_env": "QWEN_PLAN_API_KEY",
    "max_tokens": 16000,
    "extra_body": {"enable_thinking": false},
    "timeout": 300
  },
  "embedding": {
    "type": "openai",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen3.7-text-embedding-flash",
    "dimension": 1024,
    "api_key_env": "DASHSCOPE_API_KEY",
    "send_dimensions": true,
    "cache_path": "data/embed_cache.sqlite"
  },
  "search_mode": "path_a",
  "lce_enabled": true,
  "raw_base": true,
  "append_options": true,
  "skip_rejected_compiles": true,
  "keep_raw_on_compile_failure": true,
  "compile_before_search": true,
  "path_a_engine": "tree",
  "placement": "moves",
  "step1": "topic",
  "layer2": "stretches",
  "scene": "chat",
  "compile_window": {"soft": 40000, "hard": 80000, "measure": "chars", "max_messages": 200,
                     "max_chars_per_user": 10000000},
  "compile_input": {"assistant_head": 600, "blocks": true},
  "compile_concurrency": 8,
  "line_read": {"raw_k": 30, "sb_k": 30, "sbs": 16, "code_diff": true, "projection": "relay",
                "reach": 3, "extend": 32, "assistant": "told", "raw_fill": 0,
                "thread_k": 60, "thread_sbs": 0, "marks": false, "raw_of_sb": "hits",
                "hit_anchors": true, "thread_span": true,
                "forget_scope": true, "sb_raw": true, "raw_under_sb": true, "readout_tokens": 110000},
  "decision": {"base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
               "api_key_env": "QWEN_PLAN_API_KEY", "model": "decision-model-preview"},
  "read_policy": {"lce_limit": 5, "thread_limit": 3, "support_limit": 4, "source_limit": 0,
                  "include_source_text": false, "support_rank_window": 10, "min_cosine": 0.6},
  "auth_token_env": "MRMEM_AML_TOKEN",
  "host": "127.0.0.1",
  "port": 8765
}
