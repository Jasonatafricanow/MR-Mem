# Documentation only: MR-Mem reads process environment, not .env files automatically.
# Set variables only for providers you use. Never put actual credentials in this file.
QWEN_PLAN_API_KEY=
DASHSCOPE_API_KEY=
MRMEM_AML_TOKEN=
OPENAI_API_KEY=

# Docker Compose reads .env; native Python does not.
MRMEM_BIND_ADDRESS=127.0.0.1
MRMEM_HOST_PORT=8765
MRMEM_COMPILE_CONCURRENCY=8
